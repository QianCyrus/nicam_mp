################################################################################
#
# ------ FOR Earth Simulator 4, SX-AURORA -----
#
################################################################################

##### Fortran setting
#FFLAGS is set in Mkinclude. FFLAGS_DEBUG is used if NICAM_DEBUG=T

FC = mpinfort

MODDIROPT ?= -module $(BUILDDIR)
OBJDIR    ?= $(BUILDDIR)

FFLAGS_FAST  = -O3 -fpp                                        \
               -mvector-power-to-explog -mvector-power-to-sqrt \
               -std=f2003 -report-all -fextend-source          \
               -fdiag-parallel=2 -fdiag-vector=2
#               -floop-count=5000 -finline-functions -mstack-arrays

FFLAGS_QUICKDEBUG = -fcheck=bounds -minit-stack=nan -traceback

FFLAGS_DEBUG = -O1 -fpp                               \
               -fcheck=bounds -minit-stack=nan        \
               -std=f2003 -report-all -fextend-source \
               -fdiag-parallel=2 -fdiag-vector=2
#               -g -traceback -mmemory-trace


##### C setting
#CFLAGS is set in Mkinclude. CFLAGS_DEBUG is used if NICAM_DEBUG=T

CC = mpincc

#24/08/03 A.Noda
#CFLAGS_FAST  =
#CFLAGS_DEBUG = -g -traceback
CFLAGS_FAST  = -DOPT_VISIT_MOSAIC=5 -DOPT_LND_MOSAIC=1 -DOPT_LECO -DOPT_LECO_VOC -report-all -Wall -DHAVE_INTTYPES_H -O3 -finline-functions -fdiag-vector=2 -fdiag-parallel=2 -fdiag-inline=2 -traceback=verbose
CFLAGS_DEBUG = -g -minit-stack=runtime -traceback=verbose -DOPT_VISIT_MOSAIC=5 -DOPT_LND_MOSAIC=1 -DOPT_LECO -DOPT_LECO_VOC

##### Special setting

FFLAGS_OPENMP = -fopenmp

# Performance monitor
# disable
PERF_MONIT = -no-ftrace
# ftrace
#PERF_MONIT = -ftrace

FFLAGS_SYSDEPEND = $(PERF_MONIT) -DNFORT
CFLAGS_SYSDEPEND = $(PERF_MONIT) -DNFORT -DOLDNETCDF4



##### Linker setting

LD      = $(FC)
LDFLAGS = $(FFLAGS)

SOFLAGS = -shared -fPIC



################################################################################

###### NetCDF library
# Default settings
NETCDF_INCLUDE ?= -I/opt/share/NetCDF4_ve/netcdf-fortran/4.5.2/include  -I/opt/share/NetCDF4_ve/netcdf-c/4.7.2/include  -I/opt/share/HDF5_ve/1.10.5/include
NETCDF_LIBS    ?= -lnetcdff -lnetcdf -lhdf5_hl -lhdf5 -lsz -lz
#NETCDF_LIBS    ?= -L/opt/share/NetCDF4_ve/netcdf-fortran/4.5.2/lib -L/opt/share/NetCDF4_ve/netcdf-c/4.7.2/lib -L/opt/share/HDF5_ve/1.10.5/lib -L/opt/share/szip/2.1.1/lib  -L/opt/share/zlib/1.2.11/lib -lnetcdff -lnetcdf -lhdf5_hl -lhdf5 -lsz -lz
# Or, please set environment variable
# example:
# export NETCDF_INCLUDE="-I/SX/usr/local/netcdf-4.1.3/include"
# export NETCDF_LIBS="-L/SX/usr/local/netcdf-4.1.3/lib -lnetcdff -lnetcdf -lhdf5_hl -lhdf5 -lz"



###### Special library for LETKF

###### Math library
# Please set environment variable
# example:
# export MATHLIB_LIBS="-L/SX/opt/mathkeisan/inst/lib0 -llapack -lblas"

#MATHLIB_LIBS=-L/opt/nec/ve/nlc/2.3.0/lib -llapack -lblas_sequential
MATHLIB_LIBS=-L$(NLC_HOME)/lib -llapack -lblas_sequential

##### for frontend
MAKE    = make
INSTALL = cp -u
AR      = nar
ARFLAGS = r
RANLIB  = touch
