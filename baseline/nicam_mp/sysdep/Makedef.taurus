################################################################################
#
# ------ FOR Linux 64bit & gcc & intel fortran & mpich2 -----
#        (taurus.es3.jamstec.go.jp)
#
################################################################################

##### Fortran setting
#FFLAGS is set in Mkinclude. FFLAGS_DEBUG is used if NICAM_DEBUG=T

FC = mpif90 -fc=ifort -f90=ifort

MODDIROPT ?= -module $(BUILDDIR)
OBJDIR    ?=         $(BUILDDIR)

FFLAGS_FAST  = -fpp -m64 -O3 -xHost -ip             \
               -assume byterecl -convert big_endian \
               -ftz -fp-model precise -pc 80        \
               -mcmodel=medium -shared-intel        \
               -fno-alias \
               -heap-arrays

FFLAGS_QUICKDEBUG = -traceback -fpe0 -CB -CU

FFLAGS_DEBUG = -fpp -m64 -O0                        \
               -assume byterecl -convert big_endian \
               -fp-model precise -pc 80             \
               -check all -warn all -g -traceback   \
               -mcmodel=medium -shared-intel        \
               -fno-alias \
               -heap-arrays

# Note: An option -heap-arrays is not added because of the bug of the old version of Intel compiler.
#       If you meet the error caused by the stack memory, please try to use this option.



##### C setting
#CFLAGS is set in Mkinclude. CFLAGS_DEBUG is used if NICAM_DEBUG=T

CC = mpicc -cc=icc

CFLAGS_FAST  = -O3 -m64 -std=c99 -mcmodel=medium -xHost -ip -ftz -shared-intel
CFLAGS_DEBUG = -O0 -m64 -std=c99 -mcmodel=medium



##### Special setting

FFLAGS_OPENMP = -openmp -no-heap-arrays

FFLAGS_SYSDEPEND =
CFLAGS_SYSDEPEND =



##### Linker setting

LD      = $(FC)
LDFLAGS = $(FFLAGS)

SOFLAGS = -shared -fPIC



################################################################################

###### NetCDF library
# Default settings
#NETCDF_INCLUDE ?= -I/opt/share/netcdf/4.1.3/include                        \
#                  -I/opt/share/hdf5/1.8.8/include                          \
#                  -I/opt/share/szip/2.1/include                            \
#                  -I/S/data01/G6011/d0457/share_taurus/zlib/1.2.8/include  \
#                  -I/S/data01/G6011/d0457/share_taurus/curl/7.19.6/include
#NETCDF_LIBS    ?= -L/opt/share/netcdf/4.1.3/lib -lnetcdff -lnetcdf         \
#                  -L/opt/share/hdf5/1.8.8/lib -lhdf5_hl -lhdf5             \
#                  -L/opt/share/szip/2.1/lib -lsz                           \
#                  -L/S/data01/G6011/d0457/share_taurus/zlib/1.2.8/lib -lz  \
#                  -L/S/data01/G6011/d0457/share_taurus/curl/7.19.6/lib -lcurl -lrt
NETCDF_INCLUDE ?= -I/opt/share/netcdff/4.4.4-intel/include                        \
                  -I/opt/share/hdf5/1.8.20/include                          \
                  -I/opt/share/szip/2.1.1/include                            \
                  -I/S/data01/G6011/d0457/share_taurus/zlib/1.2.8/include  \
                  -I/S/data01/G6011/d0457/share_taurus/curl/7.19.6/include
NETCDF_LIBS    ?= -L/opt/share/netcdff/4.4.4-intel/lib -lnetcdff -lnetcdf   \
                  -L/opt/share/hdf5/1.8.20/lib -lhdf5_hl -lhdf5             \
                  -L/opt/share/szip/2.1.1/lib -lsz                           \
                  -L/S/data01/G6011/d0457/share_taurus/zlib/1.2.8/lib -lz  \
                  -L/S/data01/G6011/d0457/share_taurus/curl/7.19.6/lib -lcurl -lrt
# Or, please set environment variable



###### Special library for LETKF

###### Math library
# Please set environment variable
# example:
# export MATHLIB_LIBS="-mkl=sequential"



##### for frontend
MAKE    = make
INSTALL = cp -u
AR      = ar
ARFLAGS = r
RANLIB  = ranlib
