################################################################################
#
# ------ For Linux64 & NVIDIA SDK & openmpi ----- STRICT-FP VARIANT
#
# Copy of Makedef.Linux64-nvidia-ompi-time with -Mfprelaxed and -Mfpapprox
# REMOVED from FFLAGS_FAST (-Kieee retained; everything else identical,
# including -Mbyteswapio, -fast and -Mvect=assoc). Used by
# compile_strict_docker.sh (ENABLE_OPENACC=F, bin_cpu_strict) for the
# precision-attribution experiment (run/kks/precision-notes/).
#
################################################################################

##### Fortran setting
#FFLAGS is set in Mkinclude. FFLAGS_DEBUG is used if NICAM_DEBUG=T

FC = mpifort

MODDIROPT ?= -module $(BUILDDIR)
OBJDIR    ?=         $(BUILDDIR)

FFLAGS_FAST  = -Mpreprocess -m64 -fast                \
               -Mbyteswapio                           \
               -Mflushz -Kieee \
               -Mvect=assoc -mcmodel=medium

FFLAGS_QUICKDEBUG = -Ktrap=fp -Mbounds -gopt

FFLAGS_DEBUG = -Mpreprocess -m64 -O0  \
               -Mbyteswapio -Mneginfo \
               -Mflushz -Ktrap=fp     \
               -Mbounds               \
               -g -traceback



##### C setting
#CFLAGS is set in Mkinclude. CFLAGS_DEBUG is used if NICAM_DEBUG=T

CC  = mpicc

CFLAGS_FAST  = -fast
CFLAGS_DEBUG = -O0



##### Special setting

FFLAGS_OPENMP = -mp

# cc80 for A100, cc90 for H100/H200, cc120 for Blackwell
# maxregcount:128 lifts the register cap on heavy dynamics kernels
# (oprt_diffusion 220, oprt_divdamp 228, oprt3d_divdamp 184 regs/thread →
#  occupancy capped at 12.5%). 128 regs ≈ doubles theoretical occupancy.
# NOTE: global flag — measure the WHOLE run, watch for spills regressing
# already-fine kernels (radiation/microphysics). Marginal alone; pairs with
# the loop-collapse fix. Revert via Makedef.Linux64-nvidia-ompi-time.orig.
FFLAGS_OPENACC = -acc -gpu=cc120,maxregcount:128 -Minfo=accel -lnvhpcwrapnvtx

FFLAGS_SYSDEPEND = -DPGI
CFLAGS_SYSDEPEND = -DPGI



##### Linker setting

LD      = $(FC)
LDFLAGS = $(FFLAGS)

SOFLAGS = -shared -fPIC



