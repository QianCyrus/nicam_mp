################################################################################
#
# ------ FOR Linux 64bit & intel fortran & gnu C & mvapich -----
#
################################################################################

##### Fortran setting
#FFLAGS is set in Mkinclude. FFLAGS_DEBUG is used if NICAM_DEBUG=T

FC = /opt/mvapich2/1.4-intel11.0/bin/mpif90

MODDIROPT ?= -module $(BUILDDIR)
OBJDIR    ?=         $(BUILDDIR)

FFLAGS_FAST  = -fpp -m64 -O3 -xHost -ip             \
               -assume byterecl -convert big_endian \
               -ftz -fp-model precise -pc 80        \
               -mcmodel=medium -shared-intel        \
               -fno-alias

FFLAGS_QUICKDEBUG = -traceback -fpe0 -CB -CU

FFLAGS_DEBUG = -fpp -m64 -O0                        \
               -assume byterecl -convert big_endian \
               -fp-model precise -pc 80             \
               -check all -warn all -g -traceback   \
               -mcmodel=medium -shared-intel        \
               -fno-alias

# Note: An option -heap-arrays is not added because of the bug of the old version of Intel compiler.
#       If you meet the error caused by the stack memory, please try to use this option.



##### C setting
#CFLAGS is set in Mkinclude. CFLAGS_DEBUG is used if NICAM_DEBUG=T

CC = /opt/mvapich2/1.4-intel11.0/bin/mpicc

CFLAGS_FAST  = -O3 -m64 -std=c99 -xHost -ip -ftz -mcmodel=medium -shared-intel
CFLAGS_DEBUG = -O0 -m64 -std=c99



##### Special setting

FFLAGS_OPENMP = -openmp -no-heap-arrays

FFLAGS_SYSDEPEND =
CFLAGS_SYSDEPEND =



##### Linker setting

LD      = $(FC)
LDFLAGS = $(FFLAGS)

SOFLAGS = -shared -fPIC



################################################################################

###### NetCDF library
# Default settings
NETCDF_INCLUDE ?= -I$(NETCDF4)/include
NETCDF_LIBS    ?= -L$(NETCDF4)/lib -L$(HDF5)/lib -lnetcdff -lnetcdf -lhdf5_hl -lhdf5 -lm -lz
# Or, please set environment variable



###### Special library for LETKF

###### Math library
# Please set environment variable
# example:
# export MATHLIB_LIBS="-mkl=sequential"



##### for frontend
MAKE    = make
INSTALL = cp -u
AR      = ar
ARFLAGS = r
RANLIB  = ranlib
