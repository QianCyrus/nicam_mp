################################################################################
#
# ------ For Linux64 & NVIDIA SDK & openmpi -----
#
################################################################################

##### Fortran setting
#FFLAGS is set in Mkinclude. FFLAGS_DEBUG is used if NICAM_DEBUG=T

FC = mpifort

MODDIROPT ?= -module $(BUILDDIR)
OBJDIR    ?=         $(BUILDDIR)

FFLAGS_FAST  = -Mpreprocess -m64 -fast            \
               -byteswapio                           \
               -Mflushz -Mfprelaxed -Mfpapprox -Kieee \
               -Mvect=assoc -mcmodel=medium -g 

FFLAGS_QUICKDEBUG = -Ktrap=fp -Mbounds -gopt

FFLAGS_DEBUG = -Mpreprocess -m64 -O0  \
               -byteswapio -Mneginfo \
               -Mflushz -Ktrap=fp     \
               -Mbounds               \
               -g -traceback



##### C setting
#CFLAGS is set in Mkinclude. CFLAGS_DEBUG is used if NICAM_DEBUG=T

CC  = mpicc

CFLAGS_FAST  = -fast
CFLAGS_DEBUG = -O0



##### Special setting

FFLAGS_OPENMP = -mp

FFLAGS_OPENACC = -acc -gpu=cc80 -Minfo=accel -lnvhpcwrapnvtx

FFLAGS_SYSDEPEND = -DPGI
CFLAGS_SYSDEPEND = -DPGI



##### Linker setting

LD      = $(FC)
LDFLAGS = $(FFLAGS)

SOFLAGS = -shared -fPIC



################################################################################

###### NetCDF library
# Settings are inquired by using nf-config & nc-config command (see ~/Mkinclude)
# Or, please set environment variable
# example:
# export NETCDF_INCLUDE="-I/work/opt/local/aarch64/apps/nvidia/24.9/netcdf-fortran/4.6.1/include -I/work/opt/local/aarch64/apps/nvidia/24.9/netcdf/4.9.2/include -I/work/opt/local/aarch64/apps/nvidia/24.9/hdf5/1.14.5/include"
# export NETCDF_LIBS="-L/work/opt/local/aarch64/apps/nvidia/24.9/netcdf-fortran/4.6.1/lib -L/work/opt/local/aarch64/apps/nvidia/24.9/netcdf/4.9.2/lib -L/work/opt/local/aarch64/apps/nvidia/24.9/hdf5/1.14.5/lib -lnetcdff -lnetcdf -lhdf5_hl -lhdf5 -lm -lz -lbz2 -lzstd -lxml2 -lcurl"



###### Special library for LETKF

###### Math library
# Please set environment variable
# example:
# export MATHLIB_LIBS="-lacml"



##### for frontend
MAKE    = make
INSTALL = cp -u
AR      = ar
ARFLAGS = r
RANLIB  = ranlib
