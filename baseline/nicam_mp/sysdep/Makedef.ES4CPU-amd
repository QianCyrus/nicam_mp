################################################################################
#
# ------ AMD AOCC + Open MPI @ ES4 -----
#
################################################################################
##please do "module load AMD_SDK/all OpenMPI_AOCC/4.0.5" before compile

##### Fortran setting
#FFLAGS is set in Mkinclude. FFLAGS_DEBUG is used if NICAM_DEBUG=T

FC = mpifort

MODDIROPT ?= -module $(BUILDDIR)
OBJDIR    ?=         $(BUILDDIR)

FFLAGS_FAST  = -Ofast -m64 -march=znver2 -Mbyteswapio -cpp \
               -mcmodel=medium -ffp-model=source


FFLAGS_QUICKDEBUG = -traceback -fpe0 -CB -CU

FFLAGS_DEBUG = -O0 -m64 -Mbyteswapio -cpp   \
               -fpe0 -fp-model source               \
               -mcmodel=medium

# Note: An option -heap-arrays is not added because of the bug of the old version of Intel compiler.
#       If you meet the error caused by the stack memory, please try to use this option.



##### C setting
#CFLAGS is set in Mkinclude. CFLAGS_DEBUG is used if NICAM_DEBUG=T

CC = mpicc

CFLAGS_FAST  = -Ofast -m64 -march=znver2 -std=c99 -mcmodel=medium
CFLAGS_DEBUG = -O0 -m64 -std=c99



##### Special setting

FFLAGS_OPENMP = -fopenmp 

FFLAGS_SYSDEPEND = -DLOWMPITAG
CFLAGS_SYSDEPEND = -DLOWMPITAG



##### Linker setting

LD      = $(FC)
LDFLAGS = $(FFLAGS)

SOFLAGS = -shared -fPIC


################################################################################

###### NetCDF library
# Settings are inquired by using nf-config & nc-config command (see ~/Mkinclude)
# Or, please set environment variable
# example:
# export NETCDF_INCLUDE="-I/ap/netcdf4-fortran/4.4.2-intel/include -I/ap/HDF5/1.8.16-intel/include -I/ap/netcdf4/4.3.3.1-intel/include"
# export NETCDF_LIBS="-L/ap/netcdf4-fortran/4.4.2-intel/lib -L/ap/HDF5/1.8.16-intel/lib -L/ap/netcdf4/4.3.3.1-intel/lib -lnetcdff -lnetcdf"



###### Special library for LETKF

###### Math library
# Please set environment variable
# example:
# export MATHLIB_LIBS="-mkl=sequential"



##### for frontend
MAKE    = make
INSTALL = cp -u
AR      = ar
ARFLAGS = r
RANLIB  = ranlib
