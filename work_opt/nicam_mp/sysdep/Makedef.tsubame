################################################################################
#
# ------ For Tokyo Tech TSUBAME (Linux64 & intel fortran&C & intel mpi) -----
#
################################################################################

##### Fortran setting
#FFLAGS is set in Mkinclude. FFLAGS_DEBUG is used if NICAM_DEBUG=T

FC = mpiifort

MODDIROPT ?= -module $(BUILDDIR)
OBJDIR    ?=         $(BUILDDIR)

FFLAGS_FAST  = -fpp -m64 -O3 -xHost                 \
               -assume byterecl -convert big_endian \
               -fp-model source                     \
               -mcmodel=medium

FFLAGS_QUICKDEBUG = -traceback -fpe0 -CB -CU

FFLAGS_DEBUG = -fpp -m64 -O0                        \
               -assume byterecl -convert big_endian \
               -fpe0 -fp-model source               \
               -check all -warn all -g -traceback   \
               -mcmodel=medium

# Note: An option -heap-arrays is not added because of the bug of the old version of Intel compiler.
#       If you meet the error caused by the stack memory, please try to use this option.



##### C setting
#CFLAGS is set in Mkinclude. CFLAGS_DEBUG is used if NICAM_DEBUG=T

CC = mpiicc

CFLAGS_FAST  = -O3 -m64 -std=c99 -xHost -ip -ftz -mcmodel=medium -shared-intel
CFLAGS_DEBUG = -O0 -m64 -std=c99



##### Special setting

FFLAGS_OPENMP = -qopenmp -no-heap-arrays

FFLAGS_SYSDEPEND = -DLOWMPITAG
CFLAGS_SYSDEPEND = -DLOWMPITAG



##### Linker setting

LD      = $(FC)
LDFLAGS = $(FFLAGS)

SOFLAGS = -shared -fPIC



################################################################################

###### NetCDF library
# Settings are inquired by using nf-config & nc-config command (see ~/Mkinclude)
# Or, please set environment variable
# example:
export NETCDF_INCLUDE=-I/gs/hs1/[add] 2023.6 for AHE (jh230052)/dependencies/netcdf/include -I/gs/hs1/[add] 2023.6 for AHE (jh230052)/dependencies/pnetcdf-1.12.2/include -I/gs/hs1/[add] 2023.6 for AHE (jh230052)/dependencies/hdf5-1.12.1/include
export NETCDF_LIBS=-L/gs/hs1/[add] 2023.6 for AHE (jh230052)/dependencies/netcdf/lib -lnetcdff -lnetcdf -L/gs/hs1/[add] 2023.6 for AHE (jh230052)/dependencies/pnetcdf-1.12.2/lib -lpnetcdf -L/gs/hs1/[add] 2023.6 for AHE (jh230052)/dependencies/hdf5-1.12.1/lib -lhdf5_hl -lhdf5 -lz -lcurl


###### Special library for LETKF

###### Math library
# Please set environment variable
# example:
# export MATHLIB_LIBS="-mkl=sequential"



##### for frontend
MAKE    = make
INSTALL = cp -u
AR      = ar
ARFLAGS = r
RANLIB  = ranlib
