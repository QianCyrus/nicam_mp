################################################################################
#
# ------ For macOS & gnu fortran&C & openmpi -----
#
################################################################################

##### Fortran setting
#FFLAGS is set in Mkinclude. FFLAGS_DEBUG is used if NICAM_DEBUG=T

FC = mpif90

MODDIROPT ?= -J $(BUILDDIR)
OBJDIR    ?=    $(BUILDDIR)

FFLAGS_CORE = -cpp -m64                                                                   \
              -std=gnu -fall-intrinsics -pedantic-errors -fimplicit-none -fmodule-private \
              -fconvert=big-endian -frecord-marker=4 -ffree-form -ffree-line-length-none  \
              -ffpe-summary=none

FFLAGS_FAST  = -O3 $(FFLAGS_CORE)                                       \
               -funroll-loops -finline-functions -fprefetch-loop-arrays

FFLAGS_QUICKDEBUG = -ffpe-trap=invalid,zero,overflow -fcheck=bounds,do,mem,pointer -finit-real=snan -g -fbacktrace

FFLAGS_DEBUG = -O0 $(FFLAGS_CORE)                                                                   \
               -ffpe-trap=invalid,zero,overflow -fcheck=bounds,do,mem,pointer                       \
               -finit-integer=-32768 -finit-real=snan -finit-logical=false -finit-character=9       \
               -Wall -Wextra -Wcharacter-truncation -Wunderflow -Warray-temporaries -Wuninitialized \
               -Wconversion-extra                                                                   \
               -g -fbacktrace

F77FLAGS = -ffixed-form -ffixed-line-length-132



##### C setting
#CFLAGS is set in Mkinclude. CFLAGS_DEBUG is used if NICAM_DEBUG=T

CC  = mpicc

CFLAGS_FAST  = -O3 -m64
CFLAGS_DEBUG = -O0 -m64 -g



##### Special setting

FFLAGS_OPENMP = -fopenmp

FFLAGS_SYSDEPEND =
CFLAGS_SYSDEPEND =



##### Linker setting

LD      = $(FC)
LDFLAGS = $(FFLAGS)

SOFLAGS = -dynamiclib



################################################################################

###### NetCDF library
# Settings are inquired by using nf-config & nc-config command (see ~/Mkinclude)
# Or, please set environment variable
# example: (HDF5+NetCDF+NetCDF-fortran via MacPorts)
# export NETCDF_INCLUDE="-I/opt/local/include"
# export NETCDF_LIBS="-L/opt/local/lib -lnetcdff -lnetcdf"



###### ecCodes library
ifeq ($(ENABLE_ECCODES),T)
   ECCODES_INCLUDE ?= -I/opt/local/include
   ECCODES_LIBS    ?= -L/opt/local/lib -leccodes_f90 -leccodes
endif



###### Math library
# Please set environment variable
# example: (OpenBLAS via MacPorts)
# export MATHLIB_LIBS="-L/opt/local/lib -lblas -llapack"



###### Special libraries for LETKF
ifeq ($(USE_MTX_EIGENEXA),T)
   MTX_INCLUDE ?= -I/opt/ap/EigenExa
   MTX_LIBS    ?= -L/opt/ap/EigenExa -lEigenExa
   FFLAGS_SYSDEPEND += $(MTX_INCLUDE)
endif

ifeq ($(ENABLE_BUFRLIB),T)
   RTTOV_INCLUDE ?= -I/opt/ap/bufrlib
   RTTOV_LIBS    ?= -L/opt/ap/bufrlib -lbufr
endif

ifeq ($(ENABLE_RTTOV),T)
   RTTOV_INCLUDE ?= -I/opt/ap/rttov12/include -I/opt/ap/rttov12/mod
   RTTOV_LIBS    ?= -L/opt/ap/rttov12/lib -lrttov_main -lrttov_coef_io -lrttov_hdf -lrttov_parallel -L/opt/local/lib -lhdf5hl_fortran -lhdf5_hl -lhdf5_fortran -lhdf5 -lz
endif



##### for frontend
MAKE    = make
INSTALL = gcp -u # if not exist, use "install"
AR      = ar
ARFLAGS = r
RANLIB  = ranlib
