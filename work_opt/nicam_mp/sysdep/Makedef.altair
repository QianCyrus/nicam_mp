################################################################################
#
# ------ FOR Linux 64bit & gfortran4.7 & OpenMPI1.10 -----
#
################################################################################

##### Fortran setting
#FFLAGS is set in Mkinclude. FFLAGS_DEBUG is used if NICAM_DEBUG=T

FC = /usr/lib64/openmpi/bin/mpif90

MODDIROPT ?= -J $(BUILDDIR)
OBJDIR    ?=    $(BUILDDIR)

FFLAGS_CORE = -cpp -m64                                                                   \
              -std=gnu -fall-intrinsics -pedantic-errors -fimplicit-none -fmodule-private \
              -fconvert=big-endian -frecord-marker=4 -ffree-line-length-none

FFLAGS_FAST  = -O3 $(FFLAGS_CORE)                                       \
               -funroll-loops -finline-functions -fprefetch-loop-arrays \
               -mcmodel=medium

FFLAGS_QUICKDEBUG = -ffpe-trap=invalid,zero,overflow -fbounds-check -finit-real=nan -g -fbacktrace

FFLAGS_DEBUG = -O0 $(FFLAGS_CORE)                                                                   \
               -ffpe-trap=invalid,zero,overflow -fbounds-check                                      \
               -finit-integer=-32768 -finit-real=nan -finit-logical=false -finit-character=9        \
               -Wall -Wextra -Wcharacter-truncation -Wunderflow -Warray-temporaries -Wuninitialized \
               -g -fbacktrace

# Note: An option -heap-arrays is not added because of the bug of the old version of Intel compiler.
#       If you meet the error caused by the stack memory, please try to use this option.



##### C setting
#CFLAGS is set in Mkinclude. CFLAGS_DEBUG is used if NICAM_DEBUG=T

CC = /usr/lib64/openmpi/bin/mpicc

CFLAGS_FAST  = -O3 -m64 -std=c99 -mcmodel=medium
CFLAGS_DEBUG = -O0 -m64 -std=c99 -g



##### Special setting

FFLAGS_OPENMP = -fopenmp

FFLAGS_SYSDEPEND = -I/usr/lib64/mpi/gcc/openmpi/lib64 -I/usr/lib64/gfortran/modules
CFLAGS_SYSDEPEND =



##### Linker setting

LD      = $(FC)
LDFLAGS = $(FFLAGS)

SOFLAGS = -shared -fPIC



################################################################################

###### NetCDF library
# Default settings
NETCDF_INCLUDE ?= -I$(NETCDF4)/include
NETCDF_LIBS    ?= -L$(NETCDF4)/lib -L$(HDF5)/lib -lnetcdff -lnetcdf -lhdf5_hl -lhdf5 -lm -lz
# Or, please set environment variable



###### Special library for LETKF

###### Math library
# Please set environment variable
# example:
# export MATHLIB_LIBS="-L/ap/lapack/3.6.0/lib/ -llapack"



##### for frontend
MAKE    = make
INSTALL = cp -u
AR      = ar
ARFLAGS = r
RANLIB  = ranlib
