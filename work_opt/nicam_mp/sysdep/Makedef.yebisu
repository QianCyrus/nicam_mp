################################################################################
#
# ------ FOR yebisu (Linux 64bit & intel compiler) in JAMSTEC -----
#
################################################################################

##### Fortran setting
#FFLAGS is set in Mkinclude. FFLAGS_DEBUG is used if NICAM_DEBUG=T

FC = mpif90

MODDIROPT ?= -module $(BUILDDIR)
OBJDIR    ?=         $(BUILDDIR)

FFLAGS_FAST  = -fpp -m64 -O3 -xHost                 \
               -assume byterecl -convert big_endian \
               -ftz -fp-model precise -pc 80        \
               -mcmodel=medium -shared-intel        \
               -fno-alias
#  4th line -> -static-intel ? (memo by C.Kodama)

FFLAGS_QUICKDEBUG = -traceback -fpe0 -CB -CU

FFLAGS_DEBUG = -fpp -m64 -O0                        \
               -assume byterecl -convert big_endian \
               -fp-model precise -pc 80             \
               -check all -warn all -g -traceback   \
               -mcmodel=medium -shared-intel        \
               -fno-alias
#               -check noarg_temp_created  \

# Note: An option -heap-arrays is not added because of the bug of the old version of Intel compiler.
#       If you meet the error caused by the stack memory, please try to use this option.



##### C setting
#CFLAGS is set in Mkinclude. CFLAGS_DEBUG is used if NICAM_DEBUG=T

CC = mpicc

CFLAGS_FAST  = -O3 -m64 -std=c99 -mcmodel=medium
CFLAGS_DEBUG = -O0 -m64 -std=c99



##### Special setting

FFLAGS_OPENMP = -openmp -no-heap-arrays

FFLAGS_SYSDEPEND =
CFLAGS_SYSDEPEND =



##### Linker setting

LD      = $(FC)
LDFLAGS = $(FFLAGS)

SOFLAGS = -shared -fPIC



################################################################################

###### NetCDF library
# Default settings

ifeq ($(ENABLE_NETCDF),T)
        NETCDFROOT=/opt/tools/netcdf/intel-c4.6.2-f4.4.5
        NETCDF_INCLUDE ?= -I$(NETCDFROOT)/include
        NETCDF_LIBS    ?= -L$(NETCDFROOT)/lib -lnetcdff -lnetcdf -ljpeg -lmfhdf -ldf -lm -lsz -lz -lhdf5_hl -lhdf5
	# Note: before execution, type "module load netcdf/intel-c4.6.2-f4.4.5"
        FFLAGS += $(NETCDF_INCLUDE)
        CFLAGS += $(NETCDF_INCLUDE)
endif

###### Special library for LETKF

###### Math library
# Please set environment variable
# example:
# export MATHLIB_LIBS="-mkl=sequential"



##### for frontend
MAKE    = make
INSTALL = cp -u
AR      = ar
ARFLAGS = r
RANLIB  = ranlib
